# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables

# Razorpay Dashboard → Account & Settings → API Keys (use rzp_test_ keys first, then rzp_live_)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Price in rupees (keep the same as priceInr in src/config.js)
PRICE_INR=199

# Change this when you launch a NEW pack, so old buyers don't unlock the new one
PRODUCT_ID=editing-pack-v1

# Any long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=change-me-to-a-long-random-string

# Where your zip lives (Google Drive direct link, Dropbox, Cloudflare R2, etc.). Never shown on the page.
ASSET_URL=https://drive.google.com/uc?export=download&id=YOUR_FILE_ID
