# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables

# Razorpay Dashboard → Account & Settings → API Keys (use rzp_test_ keys first, then rzp_live_)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Optional: a previous Razorpay account you moved away from. Never used for new orders; only so
# its buyers can still "Restore access" and its refunds still reach the webhook.
# RAZORPAY_OLD_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_OLD_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# RAZORPAY_OLD_WEBHOOK_SECRET=the old account's webhook secret

# Prices in rupees. FULL_PRICE_INR = without a creator code, PRICE_INR = with a creator code.
# Leave FULL_PRICE_INR out to charge everyone PRICE_INR. The page reads these from /api/price.
FULL_PRICE_INR=99
PRICE_INR=49

# Change this when you launch a NEW pack, so old buyers don't unlock the new one
PRODUCT_ID=editing-pack-v1

# Any long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=change-me-to-a-long-random-string

# Where your zip lives (Google Drive direct link, Dropbox, Cloudflare R2, etc.). Never shown on the page.
ASSET_URL=https://drive.google.com/uc?export=download&id=YOUR_FILE_ID

# ---------- Influencer tracking ----------
# Upstash Redis: Vercel → your project → Storage → Upstash (Redis) → Connect. Vercel fills these in for you.
# For local dev, copy them from Vercel → Settings → Environment Variables (or run: vercel env pull .env.local)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Influencers are added on yoursite.com/stats?admin=ADMIN_KEY (saved in Upstash, no redeploy needed).

# Your own key for yoursite.com/stats?admin=THIS_KEY (at least 12 characters, keep it private)
ADMIN_KEY=change-me-to-a-long-random-string

# Razorpay Dashboard → Account & Settings → Webhooks → Add: URL https://yoursite.com/api/webhook,
# events payment.captured + refund.processed, and type the same secret here.
RAZORPAY_WEBHOOK_SECRET=change-me
